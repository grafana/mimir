FROM --platform=$BUILDPLATFORM rust:1.98.1-bookworm@sha256:93ce27a88655056a51dbdd8f5f2d7ddc071c7b0070fb288a37b5a285fc83971e AS rust-builder
ARG TARGETARCH
# Cross toolchains are only needed when the build host's architecture differs from the target's.
RUN set -eu; \
    case "$TARGETARCH" in \
      amd64) triple=x86_64-linux-gnu; package=x86-64-linux-gnu; libc=amd64 ;; \
      arm64) triple=aarch64-linux-gnu; package=aarch64-linux-gnu; libc=arm64 ;; \
      *) echo "unsupported architecture $TARGETARCH"; exit 1 ;; \
    esac; \
    if [ "$(uname -m)" != "${triple%%-*}" ]; then \
      apt-get update && apt-get install -y --no-install-recommends "gcc-$package" "g++-$package" "libc6-dev-$libc-cross" && rm -rf /var/lib/apt/lists/*; \
    fi; \
    rustup target add "${triple%%-*}-unknown-linux-gnu"; \
    echo "$triple" > /triple
WORKDIR /src
COPY cmd/rust-kafka-ingester/Cargo.toml cmd/rust-kafka-ingester/Cargo.lock ./
COPY cmd/rust-kafka-ingester/build.rs ./
COPY cmd/rust-kafka-ingester/proto ./proto
COPY cmd/rust-kafka-ingester/src ./src
COPY cmd/rust-kafka-ingester/benches ./benches
ARG ALLOCATOR=jemalloc
RUN set -eu; \
    triple=$(cat /triple); target="${triple%%-*}-unknown-linux-gnu"; \
    export "CARGO_TARGET_$(echo "$target" | tr a-z- A-Z_)_LINKER=$triple-gcc" CC="$triple-gcc" CXX="$triple-g++" AR="$triple-ar"; \
    cargo build --locked --release --target "$target" --no-default-features --features "$ALLOCATOR" --bin mimir-rust-kafka-ingester; \
    mkdir -p /out && cp "target/$target/release/mimir-rust-kafka-ingester" /out/

FROM --platform=$BUILDPLATFORM golang:1.26-bookworm@sha256:a688600ca24f8a4d3ca77f95b0dd40704a9fc787c826660eb7ba0b641b8b175d AS go-builder
WORKDIR /src
COPY go.mod go.sum ./
COPY vendor ./vendor
COPY pkg ./pkg
COPY cmd/rust-kafka-ingester/ring-sidecar ./cmd/rust-kafka-ingester/ring-sidecar
COPY cmd/rust-kafka-ingester/query-load ./cmd/rust-kafka-ingester/query-load
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=linux GOARCH=$TARGETARCH go build -mod=vendor -trimpath -o /out/rust-ingester-ring-sidecar ./cmd/rust-kafka-ingester/ring-sidecar
RUN CGO_ENABLED=0 GOOS=linux GOARCH=$TARGETARCH go build -mod=vendor -trimpath -o /out/query-load ./cmd/rust-kafka-ingester/query-load

FROM --platform=$BUILDPLATFORM debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251 AS certs
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*

FROM debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251
COPY --from=certs /etc/ssl/certs /etc/ssl/certs
COPY --from=rust-builder /out/mimir-rust-kafka-ingester /usr/local/bin/mimir-rust-kafka-ingester
COPY --from=go-builder /out/rust-ingester-ring-sidecar /usr/local/bin/rust-ingester-ring-sidecar
COPY --from=go-builder /out/query-load /usr/local/bin/query-load
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/mimir-rust-kafka-ingester"]
