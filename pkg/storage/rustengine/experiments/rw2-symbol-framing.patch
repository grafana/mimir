+func TestRW2RecordFramingMatchesDecoded(t *testing.T) {
+	for _, source := range []mimirpb.WriteRequest_SourceEnum{mimirpb.API, mimirpb.RULE, mimirpb.OTLP} {
+		req := &mimirpb.WriteRequest{Source: source, Timeseries: []mimirpb.PreallocTimeseries{
+			{TimeSeries: &mimirpb.TimeSeries{Labels: []mimirpb.LabelAdapter{{Name: "__name__", Value: "metric"}, {Name: "label", Value: "a\x00β"}}, Samples: []mimirpb.Sample{{TimestampMs: 1, Value: math.Float64frombits(0x7ff0000000000002)}, {TimestampMs: 2, Value: 3}}}},
+			{TimeSeries: &mimirpb.TimeSeries{Labels: []mimirpb.LabelAdapter{{Name: "__name__", Value: "other"}}, Samples: []mimirpb.Sample{{TimestampMs: 0, Value: 2}}, Exemplars: []mimirpb.Exemplar{{Value: 1, TimestampMs: 0}}}},
+		}}
+		records, _, err := ingest.RecordSerializerFromVersion(2).ToRecords("test", 0, "tenant", req, 1<<20)
+		require.NoError(t, err)
+		require.Len(t, records, 1)
+		data := records[0].Value
+		decoded := &mimirpb.PreallocWriteRequest{}
+		require.NoError(t, ingest.DeserializeRecordContent(data, decoded, 2))
+		record, err := ReadRW2(data, ingest.V2CommonSymbols.GetSlice(), ingest.V2RecordSymbolOffset)
+		require.NoError(t, err)
+		require.True(t, record.Complete())
+		require.Equal(t, len(decoded.Timeseries), record.Len())
+		require.Equal(t, decoded.Source, record.Source())
+		require.Equal(t, decoded.MinTimestamp(), record.MinTimestamp())
+		require.Len(t, record.Metadata(), len(decoded.GetMetadata()))
+		for i, series := range decoded.Timeseries {
+			lbls, samples := record.Series(i)
+			require.Equal(t, series.Labels, lbls)
+			require.Len(t, samples, len(series.Samples))
+			for n, sample := range samples {
+				require.Equal(t, series.Samples[n].TimestampMs, sample.TimestampMs)
+				require.Equal(t, math.Float64bits(series.Samples[n].Value), math.Float64bits(sample.Value))
+			}
+			row, ok := record.FloatSeries(i)
+			if i == 1 {
+				require.False(t, ok)
+				continue
+			}
+			require.True(t, ok)
+			var direct, expanded wireWriter
+			direct.FloatSeries(row)
+			expanded.FloatSeries(FloatSeries{Index: i, Labels: lbls, Samples: samples})
+			require.Equal(t, expanded, direct)
+		}
+		record.Release()
+		decoded.FreeBuffer()
+		mimirpb.ReuseSlice(decoded.Timeseries)
+	}
+}
+
+func FuzzRW2FastRecordMatchesDecoded(f *testing.F) {
+	req := &mimirpb.WriteRequest{Timeseries: []mimirpb.PreallocTimeseries{{TimeSeries: &mimirpb.TimeSeries{Labels: []mimirpb.LabelAdapter{{Name: "__name__", Value: "metric"}, {Name: "a", Value: "v"}}, Samples: []mimirpb.Sample{{TimestampMs: 123, Value: 5}}}}}}
+	records, _, err := ingest.RecordSerializerFromVersion(2).ToRecords("test", 0, "tenant", req, 1<<20)
+	if err != nil {
+		f.Fatal(err)
+	}
+	f.Add(records[0].Value)
+	f.Add([]byte{})
+	f.Add([]byte{0x22, 0})
+	f.Add([]byte{0x22, 1, 'x'})
+	f.Fuzz(func(t *testing.T, data []byte) {
+		if len(data) > 1<<20 {
+			t.Skip()
+		}
+		record, err := ReadRW2(data, ingest.V2CommonSymbols.GetSlice(), ingest.V2RecordSymbolOffset)
+		if err != nil {
+			return
+		}
+		defer record.Release()
+		if !record.Complete() {
+			return
+		}
+		decoded := &mimirpb.PreallocWriteRequest{}
+		err = ingest.DeserializeRecordContent(data, decoded, 2)
+		if err != nil {
+			for i := range record.Len() {
+				if _, ok := record.FloatSeries(i); !ok {
+					return
+				}
+			}
+			t.Fatalf("fast reader accepted malformed record: %v", err)
+		}
+		defer func() { decoded.FreeBuffer(); mimirpb.ReuseSlice(decoded.Timeseries) }()
+		require.Equal(t, len(decoded.Timeseries), record.Len())
+		require.Equal(t, decoded.Source, record.Source())
+		require.Equal(t, decoded.MinTimestamp(), record.MinTimestamp())
+		for i := range record.Len() {
+			if row, ok := record.FloatSeries(i); ok {
+				series := decoded.Timeseries[i]
+				var fast, full wireWriter
+				fast.FloatSeries(row)
+				full.FloatSeries(FloatSeries{Index: i, Labels: series.Labels, Samples: series.Samples})
+				require.Equal(t, full, fast)
+			}
+		}
+	})
+}
