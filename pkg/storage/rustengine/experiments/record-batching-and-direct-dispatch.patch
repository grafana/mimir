+    fn append_sample(
+        &mut self,
+        requested_reference: u64,
+        labels: Vec<Label>,
+        mut sample: Sample,
+        reject_ooo: bool,
+    ) -> Result<u64> {
+        if self.pending.is_none() {
+            return Err("no transaction".into());
+        }
+        let previous_time = self
+            .state
+            .series
+            .get(&requested_reference)
+            .and_then(|s| s.last.as_ref())
+            .map(|s| s.t);
+        let global_ooo = sample.t
+            < self
+                .state
+                .min_valid
+                .max(self.head_maxt.saturating_sub(self.block_range / 2));
+        if global_ooo {
+            let latest = self.head_maxt.max(
+                self.state
+                    .series
+                    .get(&requested_reference)
+                    .and_then(|s| s.last.as_ref())
+                    .map_or(i64::MIN, |s| s.t),
+            );
+            if reject_ooo || self.window == 0 || latest.saturating_sub(sample.t) > self.window {
+                return Err("out_of_bounds".into());
+            }
+        }
+        if global_ooo || previous_time.is_some_and(|t| sample.t < t) {
+            // Idle-evicted data can be newer than the compaction cutoff.
+            let selected = BTreeSet::from([requested_reference]);
+            for block in &self.state.cold {
+                if block.mint > sample.t
+                    || block.maxt < sample.t
+                    || !block.refs.contains(&requested_reference)
+                {
+                    continue;
+                }
+                for s in disk::read_cold(self, block, &selected, sample.t, sample.t)? {
+                    if let Some(old) = s.samples_in(sample.t, sample.t).get(&sample.t)
+                        && *old != sample
+                    {
+                        return Err("duplicate".into());
+                    }
+                }
+            }
+        }
+        let pending = self.pending.as_mut().ok_or("no transaction")?;
+        let reference = if requested_reference == 0 {
+            if labels.is_empty() || labels.windows(2).any(|w| w[0].name >= w[1].name) {
+                return Err("invalid_labels".into());
+            }
+            self.state.next_ref += 1;
+            self.state.next_ref
+        } else {
+            requested_reference
+        };
+        let existing = self.state.series.get(&reference);
+        if requested_reference != 0 && existing.is_none() && !pending.contains_key(&reference) {
+            return Err("not_found".into());
+        }
+        let new_pending = existing.is_none() && !pending.contains_key(&reference);
+        let series = pending.entry(reference).or_insert_with(|| Series {
+            reference,
+            labels: existing
+                .map(|s| s.labels.clone())
+                .unwrap_or_else(|| Arc::new(labels)),
+            ..Default::default()
+        });
+        let old = series
+            .samples
+            .get(&sample.t)
+            .cloned()
+            .or_else(|| existing.and_then(|s| s.lookup(sample.t)));
+        if let Some(old) = old {
+            if old != sample {
+                return Err("duplicate".into());
+            }
+        } else {
+            let latest = series
+                .samples
+                .last_key_value()
+                .map(|(&t, _)| t)
+                .into_iter()
+                .chain(existing.and_then(|s| s.last.as_ref()).map(|s| s.t))
+                .max();
+            if let Some(latest) = latest
+                && sample.t < latest
+                && (reject_ooo || latest.saturating_sub(sample.t) > self.window)
+            {
+                return Err(if self.window == 0 || reject_ooo {
+                    "out_of_order"
+                } else {
+                    "too_old"
+                }
+                .into());
+            }
+            sample.out_of_order = global_ooo || latest.is_some_and(|latest| sample.t < latest);
+            series.uncompacted_ooo |= sample.out_of_order;
+            series.samples.insert(sample.t, sample);
+        }
+        if new_pending {
+            self.pending_keys
+                .insert(labels_key(&series.labels), reference);
+        }
+        Ok(reference)
+    }
