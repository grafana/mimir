# SPDX-License-Identifier: AGPL-3.0-only

# These tests cover label removal at narrowing boundaries.
load 1m
  some_metric{cluster="one", namespace="first"} 1+1x5
  some_metric{cluster="two", namespace="second"} 10+2x5

# Ungrouped aggregations remove every label.
eval instant at 5m sum(max by (cluster, namespace) (some_metric)) - sum(max by (cluster, namespace) (some_metric offset 1m))
  {} 3

# An explicit empty grouping also removes every label.
eval instant at 5m sum by () (max by (cluster, namespace) (some_metric)) - sum by () (max by (cluster, namespace) (some_metric offset 1m))
  {} 3

clear

# When some series on the other side don't have a hint label, the matchers also accept series without it.
# These matchers must not select the input of an operator that removes the label, because every input series
# can contribute to the output.
load 1m
  left_metric 10
  left_metric{y="a"} 20
  right_metric{y="a"} 1
  right_metric{y="b"} 2
  other_metric{y="b"} 3

# Ungrouped aggregations remove every label.
eval instant at 0m left_metric / on (y) sum(right_metric)
  {} 3.3333333333333335

eval instant at 0m left_metric / sum(right_metric)
  {} 3.3333333333333335

eval instant at 0m sum by (y) (left_metric) / sum(right_metric)
  {} 3.3333333333333335

eval instant at 0m left_metric / on (y) sum by () (right_metric)
  {} 3.3333333333333335

eval instant at 0m left_metric / on (y) quantile(0.5, right_metric)
  {} 6.666666666666667

# The other side has no labels, so the matchers only accept series without the label.
eval instant at 0m sum(left_metric) / on (y) sum(right_metric)
  {} 10

# absent and absent_over_time only return a series when there are no input series.
eval instant at 0m left_metric / on (y) absent(other_metric)

eval instant at 0m left_metric / on (y) absent_over_time(other_metric[5m])

clear

# One-to-one matching keeps only the on labels, or removes the ignored labels.
load 1m
  left_metric 10
  left_metric{y="a"} 20
  right_metric{y="b", z="1"} 2
  other_metric{z="1"} 3

eval instant at 0m left_metric / on (y) (right_metric * on (z) other_metric)
  {} 1.6666666666666667

eval instant at 0m left_metric / on (y) (right_metric * ignoring (y) other_metric)
  {} 1.6666666666666667

clear

# Histogram functions remove the le label.
load 1m
  left_metric 10
  left_metric{le="0.5"} 20
  right_bucket{le="0.5"} 1
  right_bucket{le="1"} 2
  right_bucket{le="+Inf"} 2

eval instant at 0m left_metric / histogram_quantile(0.5, right_bucket)
  {} 20

eval instant at 0m left_metric / histogram_fraction(0, 0.5, right_bucket)
  {} 20

eval instant at 0m left_metric / ignoring (q) histogram_quantiles(right_bucket, "q", 0.5)
  {} 20

clear

# Without aggregations remove only the listed labels.
# Runtime matcher filtering also protects this case.
load 1m
  some_metric{cluster="one", instance="a"} 1+1x5
  some_metric{cluster="one", instance="b"} 10+2x5

eval instant at 5m sum without (instance) (max by (cluster, instance) (some_metric)) - sum without (instance) (max by (cluster, instance) (some_metric offset 1m))
  {cluster="one"} 3

clear

# histogram_quantile removes the le label from its aggregation output.
# Runtime metadata also protects this case.
load 1m
  some_bucket{cluster="one", le="0.5"} 1+1x5
  some_bucket{cluster="one", le="+Inf"} 2+2x5

eval instant at 5m histogram_quantile(0.5, sum by (cluster, le) (some_bucket)) - histogram_quantile(0.5, sum by (cluster, le) (some_bucket offset 1m))
  {cluster="one"} 0

clear

# Default matching ignores the metric name.
load 1m
  some_metric{cluster="one"} 1+1x5
  some_other_metric{cluster="one"} 2+2x5

eval instant at 5m sum by (__name__, cluster) (some_metric) / some_other_metric
  {cluster="one"} 0.5

clear

# info adds labels that do not exist on its inner selector.
load 1m
  metric_total{instance="a", job="1"} 1+1x5
  other_total{instance="a", job="1"} 2+2x5
  target_info{data="info", instance="a", job="1"} 1+0x5

eval instant at 5m info(sum by (job, instance) (metric_total), {data=~".+"}) - info(other_total, {data=~".+"})
  {data="info", instance="a", job="1"} -6

eval instant at 5m info(metric_total, {data=~".+"}) - info(other_total, {data=~".+"})
  {data="info", instance="a", job="1"} -6

clear

# count_values adds a label, so it does not exist on the selectors inside count_values.
load 1m
  first_metric{job="j", pod="a"} 1+0x5
  second_metric{job="j", pod="a"} 1+0x5

eval instant at 5m count_values("v", first_metric) + on (v) count_values("v", second_metric)
  {v="1"} 2

eval instant at 5m count_values("v", first_metric) + count_values("v", second_metric)
  {v="1"} 2

eval instant at 5m count_values by (job) ("v", first_metric) + on (job, v) count_values by (job) ("v", second_metric)
  {job="j", v="1"} 2

eval instant at 5m count_values without (pod) ("v", first_metric) + on (job, v) count_values without (pod) ("v", second_metric)
  {job="j", v="1"} 2

clear

# group_left and group_right copy labels from the "one" side, so they do not exist on the "many" side selectors.
load 1m
  probe_sum{instance="a", job="1", probe="p1"} 0+2x5
  probe_count{instance="a", job="1", probe="p1"} 0+1x5
  check_info{check_name="http", instance="a", job="1", probe="p1"} 1+0x5

eval instant at 5m sum by (instance, job, check_name) (probe_sum * on (instance, job, probe) group_left (check_name) check_info) / sum by (instance, job, check_name) (probe_count * on (instance, job, probe) group_left (check_name) check_info)
  {check_name="http", instance="a", job="1"} 2

eval instant at 5m sum by (instance, job, check_name) (check_info * on (instance, job, probe) group_right (check_name) probe_sum) / sum by (instance, job, check_name) (check_info * on (instance, job, probe) group_right (check_name) probe_count)
  {check_name="http", instance="a", job="1"} 2

eval instant at 5m sum by (instance, job, check_name) (probe_sum * on (instance, job, probe) group_left (check_name) check_info) / on (instance, job, check_name) sum by (instance, job, check_name) (probe_count * on (instance, job, probe) group_left (check_name) check_info)
  {check_name="http", instance="a", job="1"} 2

clear

# When the "many" side has a label that group_left or group_right copies, the result takes its value from the "one" side.
load 1m
  ratio_total{env="prod", region="us"} 8+0x5
  many_metric{env="prod", region="old"} 2+0x5
  one_metric{env="prod", region="us"} 4+0x5

eval instant at 5m ratio_total / on (env, region) (many_metric * on (env) group_left (region) one_metric)
  {env="prod", region="us"} 1

eval instant at 5m ratio_total / on (env, region) (one_metric * on (env) group_right (region) many_metric)
  {env="prod", region="us"} 1

clear

# With ignoring, the result has the ignored labels of the "many" side, and the "one" side does not have them.
load 1m
  ratio_total{pod="a"} 1+0x5
  many_metric{env="prod", pod="a"} 2+0x5
  one_metric{env="prod"} 4+0x5
  one_metric_with_region{env="prod", region="us"} 4+0x5

eval instant at 5m sum by (pod) (ratio_total) / on (pod) (many_metric * ignoring (pod) group_left one_metric)
  {pod="a"} 0.125

eval instant at 5m sum by (pod) (ratio_total) / on (pod) (one_metric * ignoring (pod) group_right many_metric)
  {pod="a"} 0.125

eval instant at 5m sum by (pod) (ratio_total) / on (pod) (many_metric * ignoring (pod, region) group_left (region) one_metric_with_region)
  {pod="a"} 0.125

clear

# A comparison without bool keeps the metric name of the "many" side, and the sides never match on the metric name with ignoring or default matching.
load 1m
  many_metric{env="prod", pod="a"} 2+0x5
  one_metric{env="prod", pod="a"} 1+0x5
  one_metric_without_pod{env="prod"} 1+0x5

eval instant at 5m many_metric / on (__name__, pod) (many_metric > ignoring (pod) group_left one_metric_without_pod)
  {pod="a"} 1

eval instant at 5m many_metric / on (__name__, pod) (one_metric_without_pod < ignoring (pod) group_right many_metric)
  {pod="a"} 2

eval instant at 5m many_metric / on (__name__, pod) (many_metric > ignoring () group_left one_metric)
  {pod="a"} 1

clear

# Many operations remove the metric name, so narrowing must not add a metric name matcher to the selectors.
load 1m
  ratio_total{env="prod", pod="a"} 8+0x5
  many_metric{env="prod", pod="a"} 2+0x5
  many_metric{env="prod", pod="b"} 3+0x5
  one_metric{env="prod"} 4+0x5

eval instant at 5m sum by (pod) (ratio_total) / on (__name__, pod) abs(many_metric)
  {pod="a"} 4

eval instant at 5m sum by (pod) (ratio_total) and on (__name__, pod) abs(many_metric)
  {pod="a"} 8

eval instant at 5m sum by (pod) (ratio_total) / on (__name__, pod) (many_metric * on (env) group_left one_metric)
  {pod="a"} 1

clear

# topk and bottomk select series in each group, so a matcher for a label that is not a
# grouping label changes which series they select.
load 1m
  left_metric{y="b"} 10
  right_metric{y="a"} 5
  right_metric{y="b"} 1
  other_metric{y="a"} 1
  other_metric{y="b"} 5
  first_metric{y="a", z="1"} 4
  second_metric{y="b", z="1"} 5

eval instant at 0m left_metric / on (y) topk(1, right_metric)

eval instant at 0m left_metric / on (y) bottomk(1, other_metric)

eval instant at 0m left_metric / on (y) topk by (y) (1, right_metric)
  {y="b"} 10

# limit_ratio selects each series from a hash of its own labels, so narrowing doesn't change which series it selects.
eval instant at 0m left_metric / on (y) limit_ratio(-0.5, right_metric)
  {y="b"} 10

# or only returns an RHS series if no LHS series has the same values for the matching labels.
# A matcher for another label can remove this LHS series, so the RHS series is returned.
eval instant at 0m left_metric / on (y) (first_metric or on (z) second_metric)

eval instant at 0m left_metric / on (y) (first_metric or ignoring (y) second_metric)
